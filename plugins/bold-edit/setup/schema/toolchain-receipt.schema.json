{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bold.toolchain-receipt/1 — tudo o que o bold setup criou (base de verify/rollback/uninstall)",
  "type": "object",
  "required": [
    "schema",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bold.toolchain-receipt/1"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "tool",
        "version",
        "platform",
        "dir",
        "tree_sha256",
        "files",
        "artifact",
        "installed_at",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "darwin-arm64",
            "darwin-x64",
            "win32-x64"
          ]
        },
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "artifact": {
          "type": "object",
          "required": [
            "kind",
            "sha256",
            "license",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "simulated-dir",
                "archive",
                "npm"
              ]
            },
            "name": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "sha256",
                  "size"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "installed_at": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "INACTIVE"
          ]
        },
        "codesign": {
          "$ref": "#/$defs/codesign"
        }
      }
    },
    "codesign": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "policy",
            "team_id",
            "bins",
            "verified_at"
          ],
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "REQUIRED"
            },
            "team_id": {
              "type": "string",
              "pattern": "^[A-Z0-9]{10}$"
            },
            "authority": {
              "const": "Developer ID Application"
            },
            "hardened_runtime": {
              "type": "boolean"
            },
            "bins": {
              "type": "object",
              "patternProperties": {
                "^[a-z][a-z0-9-]*$": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "identifier": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "minLength": 1
                        }
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "verified_at": {
              "type": "string"
            },
            "migrated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "policy",
            "approved",
            "macho",
            "verified_at"
          ],
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "ADHOC_PINNED"
            },
            "approved": {
              "type": "string",
              "minLength": 1
            },
            "macho": {
              "type": "object",
              "patternProperties": {
                "^[A-Za-z0-9._+@-]+(/[A-Za-z0-9._+@-]+)*$": {
                  "type": "object",
                  "required": [
                    "cdhash"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "cdhash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "phase": {
                      "enum": [
                        "extract",
                        "post_install"
                      ]
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "verified_at": {
              "type": "string"
            },
            "migrated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "policy",
            "approved",
            "lockfile_sha256",
            "native",
            "verified_at"
          ],
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "NPM_NATIVE_PINNED"
            },
            "approved": {
              "type": "string",
              "minLength": 1
            },
            "lockfile_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "native": {
              "type": "object",
              "patternProperties": {
                "^node_modules/[A-Za-z0-9._@+/-]+$": {
                  "type": "object",
                  "required": [
                    "package",
                    "version",
                    "sha256",
                    "cdhash"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "package": {
                      "type": "string",
                      "pattern": "^(@[a-z0-9._-]+/)?[a-z0-9._-]+$"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "cdhash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "verified_at": {
              "type": "string"
            },
            "migrated": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
